# =====================================================================================================
#  HomeRoster secrets. scripts/install.sh writes the real .env (mode 600). NEVER commit it.
#  Every ${VARIABLE} referenced in config/homeroster.yaml must be defined here.
# =====================================================================================================

# Asked ONCE, when creating the admin account (generated by install.sh)
HOMEROSTER_SETUP_TOKEN=

# Container timezone (dates in the activity log)
TZ=UTC

# VPN, WGDashboard: Settings > WGDashboard API Keys
WG_API_KEY=
# VPN, wg-easy: a user without 2FA
WG_EASY_USERNAME=
WG_EASY_PASSWORD=

# VPN, Tailscale / Headscale / NetBird / ZeroTier (only the one you use)
TAILSCALE_API_KEY=
HEADSCALE_API_KEY=
NETBIRD_TOKEN=
ZEROTIER_TOKEN=

# Reverse proxy, Nginx Proxy Manager: a dedicated user (Proxy Hosts + Access Lists = Manage)
NPM_EMAIL=
NPM_PASSWORD=
# Reverse proxy, Traefik: only if its API is behind basic auth
TRAEFIK_API_USERNAME=
TRAEFIK_API_PASSWORD=
# Reverse proxy, Zoraxy: a dedicated admin account
ZORAXY_USERNAME=
ZORAXY_PASSWORD=

# Apps
JELLYFIN_API_KEY=
SEERR_API_KEY=
IMMICH_API_KEY=
OPENWEBUI_API_KEY=
PLEX_TOKEN=
EMBY_API_KEY=
AUDIOBOOKSHELF_API_KEY=
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
VAULTWARDEN_ADMIN_TOKEN=
HOMEASSISTANT_TOKEN=
NEXTCLOUD_ADMIN_USER=
NEXTCLOUD_ADMIN_PASSWORD=

# E-mail (for Gmail: an app password, https://myaccount.google.com/apppasswords)
SMTP_USERNAME=
SMTP_PASSWORD=
